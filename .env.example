# Copie para .env (no computador) ou cadastre no GitHub (Settings → Secrets and variables → Actions → Secrets).
# Nenhuma chave entra no repositório.

# API-Football (plano Pro): https://dashboard.api-football.com
APIFOOTBALL_KEY=

# Linhas das casas: URL da função "linhas" do Supabase deste projeto (GET ?latest=1 devolve a última foto de cada casa)
LINHAS_URL=https://mccxlgtiulpknubdiyrz.supabase.co/functions/v1/linhas

# Teto de pedidos à API-Football por execução (protege a cota diária de 7.500 do Pro)
APIF_MAX_RUN=600
# Teto do preenchimento do histórico por execução (jogos já encerrados)
HIST_MAX_RUN=1500
